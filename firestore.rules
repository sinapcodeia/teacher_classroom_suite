rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── FUNCIONES AUXILIARES ────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwnDocument(userId) {
      return request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return request.auth.token.email in [
        'sinapcodeia@gmail.com',
        'antonio_rburgos@msn.com'
      ];
    }

    // ── USUARIOS (/users/{userId}) ─────────────────────────────────────────
    // Todos los usuarios autenticados pueden leer el directorio institucional de docentes.
    // Cada usuario solo puede crear o actualizar su propio perfil (o SuperAdmin).
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwnDocument(userId);
      allow update: if isAuthenticated() && (isOwnDocument(userId) || isSuperAdmin());
      allow delete: if isAuthenticated() && isSuperAdmin();
    }

    // ── DIRECTORIO INSTITUCIONAL (/directorio/{staffId}) ────────────────────
    match /directorio/{staffId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── ESTUDIANTES (/students/{studentId}) ───────────────────────────────
    // Todos los docentes autenticados pueden leer estudiantes.
    // Solo docentes activos y admins pueden crear/editar.
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── NOTAS DE AGENDA (/agendaNotes/{noteId}) ───────────────────────────
    match /agendaNotes/{noteId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── CURRÍCULO (/curriculum/{curriculumId}) ────────────────────────────
    match /curriculum/{curriculumId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── RECUPERACIONES (/recoveryPlans/{planId}) ─────────────────────────
    match /recoveryPlans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── PLANES PEDAGÓGICOS IA (/pedagogical_plans/{planId}) ───────────────
    match /pedagogical_plans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── MASTER DATA (/masterData/{docId}) ─────────────────────────────────
    match /masterData/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isSuperAdmin();
    }

    // ── SETTINGS (/settings/{docId}) ──────────────────────────────────────
    // Usado para masterData sincronizado en tiempo real entre dispositivos.
    // Todos los docentes pueden leer. Solo SuperAdmin puede escribir.
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── CONVIVENCIA (/convivencia/{id}) ───────────────────────────────────
    match /convivencia/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── LOGS DE AUDITORÍA (/auditLogs/{logId}) ───────────────────────────
    // Solo lectura para SuperAdmin, escritura para cualquier usuario autenticado
    match /auditLogs/{logId} {
      allow read: if isAuthenticated() && isSuperAdmin();
      allow create: if isAuthenticated();
    }
  }
}
